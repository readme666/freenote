{
  "linux_targets": {
    "ubuntu-22": {
      "displayed_name": "Ubuntu 22.04",
      "runner": "ubuntu-22.04",
      "build_appimage": "true",
      "run_ci": "true"
    }
  },
  "macos_targets": {
    "mac-x64": {
      "displayed_name": "MacOS x64",
      "runner": "macos-15-intel",
      "extra_cmake_flags": "-DENABLE_FLOAT_FROM_CHARS=off",
      "run_ci": "true"
    }
  },
  "windows_targets": {
    "windows": {
      "displayed_name": "Windows x86_64",
      "runner": "windows-2022",
      "msystem": "mingw64",
      "msys_package_env": "x86_64",
      "build_portable": "true",
      "run_ci": "true"
    }
  }
}
